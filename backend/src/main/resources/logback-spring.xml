<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="bibliophiles-bazaar"/>
    <springProperty scope="context" name="env" source="spring.profiles.active" defaultValue="production"/>

    <springProperty scope="context" name="LOG_DIR" source="logging.file.path" defaultValue="logs"/>
    <property name="LOG_FILE" value="bibliophiles-bazaar"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="com.adarsh.backend.shared.infrastructure.logging.JsonLayout">
                <appName>${appName}</appName>
                <env>${env}</env>
            </layout>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${LOG_FILE}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${LOG_FILE}.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="com.adarsh.backend.shared.infrastructure.logging.JsonLayout">
                <appName>${appName}</appName>
                <env>${env}</env>
            </layout>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
    <logger name="com.adarsh.backend" level="INFO"/>
    <logger name="org.springframework.web" level="INFO"/>
</configuration>
